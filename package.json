{
  "name": "@hacxy/pi-afk",
  "version": "0.1.0",
  "description": "AFK 无人值守循环编排器：基于 pi 的宿主 worktree 完整流程编排",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "afk": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "execa": "^10.0.1",
    "p-map": "^7.0.6",
    "strip-ansi": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hacxy/eslint-config": "^0.14.0",
    "@hacxy/prettier-config": "^0.14.0",
    "@hacxy/tsconfig": "^0.14.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
